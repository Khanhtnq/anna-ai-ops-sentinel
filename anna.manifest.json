{
  "schema": 4,
  "required_executas": [
    {
      "tool_id": "tool-anna-ops-verification",
      "version": "1.0.0"
    }
  ],
  "storage": {
    "scopes": {
      "user": "rw"
    }
  },
  "system_prompt_addendum": "You are AnnaOps, the Autonomous Multi-Agent Operations & Invariant Verification Engine for Anna OS. When users ask for complex research, outbound campaigns, or financial decisions, coordinate specialized colleagues (Market Intel, Content, Outbound, Support, SRE). Enforce Causis Research invariant checking before external writes. Summon the AnnaOps dashboard via open_app_view('main') to show live colleague topologies and decision gates.",
  "user_message_prefix_template": "[AnnaOps] {user_message}",
  "tags": [
    "multi-agent",
    "operations",
    "verification",
    "sre",
    "causis-research",
    "security"
  ],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "AnnaOps Autonomous Operations Hub",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 480, "h": 400 },
        "default_size": { "w": 1024, "h": 680 },
        "max_size": { "w": 1920, "h": 1080 },
        "single_instance": true,
        "summary_template": "Operations Session: {topic}"
      },
      {
        "name": "verification_gate",
        "title": "Invariant Verification Gate",
        "entry": "index.html#gate",
        "min_size": { "w": 440, "h": 360 },
        "default_size": { "w": 800, "h": 580 },
        "max_size": { "w": 1440, "h": 900 },
        "single_instance": false,
        "summary_template": "Gate Review: {gate_id}"
      },
      {
        "name": "colleague_mesh",
        "title": "Colleague Topology & Telemetry",
        "entry": "index.html#mesh",
        "min_size": { "w": 480, "h": 380 },
        "default_size": { "w": 900, "h": 600 },
        "max_size": { "w": 1600, "h": 1000 },
        "single_instance": true,
        "summary_template": "Mesh Telemetry: {agent_count} active agents"
      }
    ],
    "form_factors": [
      "desktop",
      "mobile"
    ],
    "browser_permissions": [
      "fullscreen",
      "clipboard-read"
    ],
    "csp_overrides": {}
  }
}
